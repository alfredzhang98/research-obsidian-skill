-    _apikey = lambda s: ''
+# Keys are read from environment variables (GEMINI_API_KEY, OPENAI_API_KEY,
+# DATALAB_API_KEY) with a legacy fallback to ~/.claude/CLAUDE.md lines like:
+# **ServiceName**: `your-key`
+def _apikey(name: str) -> str:
+    if not name:
+        return ''
+    env = os.environ.get(name.upper() + '_API_KEY', '')
+    if env:
+        return env
+    try:
+        _claude_md = open(os.path.expanduser('~/.claude/CLAUDE.md')).read()
+        _m = re.search(rf'\*\*{name}\*\*:\s*`([^`]+)`', _claude_md, re.IGNORECASE)
+        return _m.group(1) if _m else ''
+    except Exception:
+        return ''

